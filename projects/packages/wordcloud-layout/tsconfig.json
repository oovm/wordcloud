{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2020", "DOM"],
        "moduleResolution": "node",
        "outDir": "./dist",
        "rootDir": "./src",
        "noEmit": false,
        "allowImportingTsExtensions": false,
        "noUncheckedIndexedAccess": false,
        "strictNullChecks": false
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "tests"]
}
