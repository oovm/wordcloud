{
    "name": "@doki-land/wordcloud-element",
    "version": "0.1.0",
    "description": "<word-cloud> custom element for @doki-land/wordcloud",
    "type": "module",
    "sideEffects": true,
    "license": "MIT",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rm -rf dist",
        "type-check": "tsc --noEmit"
    },
    "keywords": [
        "wordcloud",
        "web-component",
        "custom-element"
    ],
    "dependencies": {
        "@doki-land/wordcloud": "workspace:*",
        "@doki-land/wordcloud-core": "workspace:*"
    },
    "devDependencies": {
        "typescript": "^5.0.0"
    }
}
