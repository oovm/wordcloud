{
  "name": "wordcloud-ts",
  "version": "1.0.0",
  "description": "TypeScript WordCloud Renderer with QuadTree Layout Engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist",
    "lint": "echo 'No linting configured'",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["wordcloud", "typescript", "quadtree", "canvas", "svg"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "jsdom": "^23.0.0"
  },
  "dependencies": {
    "canvas": "^2.11.0"
  }
}