{
  "name": "wordcloud-web",
  "version": "1.0.0",
  "description": "WordCloud Web Playground - Vue3 + Vite + TypeScript + Sass",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf dist",
    "lint": "echo 'No linting configured'"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "@vueuse/core": "^10.7.0",
    "papaparse": "^5.4.0",
    "file-saver": "^2.0.5",
    "@iconify/vue": "^4.1.1",
    "@iconify/json": "^2.2.0",
    "nodejieba": "^2.6.0",
    "natural": "^6.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.4.0",
    "@vue/tsconfig": "^0.4.0",
    "typescript": "^5.0.0",
    "vite": "^4.4.0",
    "vue-tsc": "^1.8.0",
    "@types/papaparse": "^5.3.0",
    "@types/file-saver": "^2.0.0",
    "@types/natural": "^5.1.0",
    "unplugin-auto-import": "^0.16.0",
    "unplugin-vue-components": "^0.25.0",
    "unocss": "^0.57.0",
    "@unocss/reset": "^0.57.0",
    "@iconify-json/carbon": "^1.1.0",
    "@iconify-json/mdi": "^1.1.0",
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "jsdom": "^23.0.0"
  },
  "keywords": [
    "wordcloud",
    "vue3",
    "vite",
    "typescript",
    "playground",
    "visualization"
  ],
  "author": "",
  "license": "MIT"
}